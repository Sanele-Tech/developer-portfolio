# Local PostgreSQL connection used by Docker Compose and Spring Boot.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Optional email settings. Leave blank to disable SMTP authentication/configuration.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
PORTFOLIO_MAIL_FROM=
PORTFOLIO_NOTIFICATION_EMAIL=

# Optional application settings (defaults shown).
PORTFOLIO_MEDIA_PUBLIC_BASE_URL=http://localhost:8080
PORTFOLIO_CONTACT_RATE_LIMIT_MAXIMUM=5
PORTFOLIO_CONTACT_RATE_LIMIT_WINDOW=15m
